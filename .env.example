PORT=3000
MONGO_URI=mongodb://localhost:27017/dentacare
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:4200

# Demo seed account. Keep portfolio/demo deployments fictional.
SEED_ADMIN_EMAIL=admin@dentacare.example
SEED_ADMIN_NAME=DentaCare Demo Admin
SEED_ADMIN_ID_NUMBER=9001015009087
SEED_ADMIN_PASSWORD=replace-with-a-demo-password

# Optional appointment/password reset email delivery via Gmail app password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional Cloudinary configuration if file-upload features are enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
