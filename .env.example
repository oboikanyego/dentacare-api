PORT=3000
MONGO_URI=mongodb://localhost:27017/dentacare
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Comma-separated browser origins allowed to call the API.
# Example for the hosted UI:
# CORS_ORIGIN=https://dentacare-ec0038.netlify.app,https://main--dentacare-ec0038.netlify.app
CORS_ORIGIN=http://localhost:4200

# Optional override for the built-in sample accounts used by the portfolio UI.
# If omitted, the repository's sample password is used.
SAMPLE_USER_PASSWORD=

# Optional additional admin seed account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_ID_NUMBER=
SEED_ADMIN_PASSWORD=

# Optional appointment/password reset email delivery via Gmail app password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional Cloudinary configuration if file-upload features are enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
